# Neon Postgres (or any Postgres compatible with @neondatabase/serverless)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional: comma-separated extra CORS origins (preview URLs, etc.)
# CORS_ORIGINS=https://your-preview.vercel.app

# Optional: bearer token to list recent leads via GET /api/leads (for you / scripts only)
# LEADS_READ_TOKEN=
